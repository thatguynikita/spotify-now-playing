# OS cruft
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local secrets. infra/vps/spotify-widget.env is a placeholder
# template, not real secrets.
*.env
!infra/vps/spotify-widget.env

# Terraform. *.tfvars holds real credentials -- never commit; only
# *.tfvars.example. State can hold secrets too.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# Cloud Function build artifacts
infra/**/build/

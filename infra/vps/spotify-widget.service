[Unit]
Description=Fetch Spotify now-playing track and write it to a static JSON file
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/spotify-widget.env
ExecStart=/usr/bin/python3 /opt/spotify-widget/spotify_now_playing.py

# Same user nginx uses -- must own/write OUTPUT_PATH's directory.
User=www-data
Group=www-data

# Sandboxing: must match OUTPUT_PATH's directory or writes fail
# (systemd-level, not just chmod). Placeholder -- set to your own.
ReadWritePaths=/var/www/your-domain-name
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
